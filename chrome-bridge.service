[Unit]
Description=Chrome Bridge (Paseo agent -> your real Chrome)
Documentation=https://github.com/papag00se/chrome-bridge
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/jesse/Work/chrome-bridge/bridge
Environment=BRIDGE_PORT=8787
ExecStart=/home/jesse/.local/share/mise/installs/node/26.7.0/bin/node /home/jesse/Work/chrome-bridge/bridge/server.mjs
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
