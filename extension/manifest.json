{
  "manifest_version": 3,
  "name": "Chrome Bridge (Paseo)",
  "version": "0.2.0",
  "description": "Lets your Paseo agent drive THIS browser (your real, logged-in Chrome) via a localhost bridge.",
  "permissions": ["debugger", "tabs", "tabGroups", "alarms", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chrome Bridge"
  }
}
